# Copy this file to .env (same folder) and fill it in. .env is never committed.
# The demo holds no real keys: nothing here belongs to the main app.

# beta while the main site is being tested, live once citerank.com is switched over.
# It decides where the demo's links back to the marketing site go.
STAGE=beta

DEMO_HOST=demo.citerank.com

# Database password. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Make each of these with: openssl rand -base64 32. Never reuse the main app's.
BETTER_AUTH_SECRET=
ELMO_ENCRYPTION_KEY=
