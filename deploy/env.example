# Copy this file to .env (same folder) and fill it in. .env is never committed.
# Put a value with spaces inside single quotes.

# beta while testing, live on launch day. Nothing else changes between the two
# except the sign-up list below.
STAGE=beta

# The app's address. It is the same before and after launch.
APP_HOST=app.citerank.com

# Database password. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Make each of these with: openssl rand -base64 32
# Keep a copy somewhere safe: without ELMO_ENCRYPTION_KEY the stored keys cannot be read.
BETTER_AUTH_SECRET=
ELMO_ENCRYPTION_KEY=

# Who may create an account: emails or @domain entries, separated by commas.
# A single * opens sign-up to everyone. Empty lets nobody in.
CLOUD_SIGNUP_ALLOWLIST=

# Stripe. Use the test keys (sk_test_...) until launch day.
# The webhook goes to https://app.citerank.com/api/auth/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend, for sign-up and billing emails. The sender's domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL='CiteRank.com <hello@citerank.com>'

# Google sign-in. The redirect address is https://app.citerank.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile, the bot check on sign-up. Leave both empty to run without it.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The AI tools on sale and who fetches each one, as model:provider[:version][:online].
# Every provider named here needs its key below.
SCRAPE_TARGETS=

# Provider keys. Fill in only the ones SCRAPE_TARGETS names.
BRIGHTDATA_API_TOKEN=
CLORO_API_KEY=
OLOSTEP_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Jev, which judges mentions and sentiment.
TYPESAFE_API_KEY=

# The Cloud Storage bucket the nightly database backup is copied to (name only, no gs://).
BACKUP_BUCKET=
