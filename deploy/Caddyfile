# Caddy gets and renews the certificates itself, once each name's DNS record points at this server.

{
	servers {
		# Cloudflare's own addresses, from cloudflare.com/ips. A request from one of
		# them names the visitor in CF-Connecting-IP; from anywhere else, the sender is the visitor.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$APP_HOST} {
	encode zstd gzip
	reverse_proxy web:3000 {
		# One address, the visitor's. The app's sign-in limits distrust a list and
		# would then count every visitor as the same one.
		header_up X-Forwarded-For {client_ip}
	}
}

{$SITE_HOSTS} {
	# After launch the test address and www send visitors to the live one.
	@moved host {$REDIRECT_HOSTS}
	redir @moved https://citerank.com{uri} permanent

	encode zstd gzip
	reverse_proxy www:3001
}
