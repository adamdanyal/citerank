{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*", "../web/src/*"],
			"@workspace/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["node_modules"]
}
